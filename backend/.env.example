PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/tripcraft
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRES_IN=15m
# Keep the Ignav key server-side; never expose it through VITE_* variables.
IGNAV_API_KEY=
IGNAV_FREE_ALLOWANCE=1000
IGNAV_INTERNAL_LIMIT=800
IGNAV_INITIAL_USED=2
IGNAV_CACHE_TTL_MINUTES=30
IGNAV_LIVE_SEARCH_ENABLED=false
IGNAV_USER_RATE_LIMIT_PER_MINUTE=10
IGNAV_REQUEST_TIMEOUT_MS=30000
IGNAV_USAGE_ADMIN_EMAILS=
